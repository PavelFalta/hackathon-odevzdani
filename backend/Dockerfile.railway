# Build from repository root (Railway: Root Directory = `.`, Dockerfile = backend/Dockerfile.railway).
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    KNOWLEDGE_DIR=/app/datazapad/knowledge

COPY backend ./backend
COPY scripts/build-knowledge-base.py ./scripts/build-knowledge-base.py
COPY datazapad ./datazapad

WORKDIR /app/backend
RUN pip install --no-cache-dir -e .

# OpenAI at build time → same embeddings as runtime (KNOWLEDGE_EMBEDDER=openai).
# Without it, index is built with hash; set KNOWLEDGE_EMBEDDER=hash in Railway too.
ARG OPENAI_API_KEY
ENV OPENAI_API_KEY=${OPENAI_API_KEY}
RUN if [ -n "$OPENAI_API_KEY" ]; then \
      python ../scripts/build-knowledge-base.py; \
    else \
      python ../scripts/build-knowledge-base.py --embedder hash; \
    fi

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
